plugins {
    id 'fabric-loom' version '1.3-SNAPSHOT'
    id 'maven-publish'
}

sourceCompatibility = JavaVersion.VERSION_17
targetCompatibility = JavaVersion.VERSION_17

repositories {
    mavenCentral()
    maven {
        name = "Fabric"
        url = "https://maven.fabricmc.net/"
    }
}

dependencies {
{{#if mcVersion1192}}
    minecraft "com.mojang:minecraft:1.19.2"
    mappings loom.officialMojangMappings()
    modImplementation "net.fabricmc:fabric-loader:0.14.+"
    modImplementation "net.fabricmc.fabric-api:fabric-api:0.76.+"
{{else if mcVersion1201}}
    minecraft "com.mojang:minecraft:1.20.1"
    mappings loom.officialMojangMappings()
    modImplementation "net.fabricmc:fabric-loader:0.14.+"
    modImplementation "net.fabricmc.fabric-api:fabric-api:0.92.+"
{{else if mcVersion121x}}
    minecraft "com.mojang:minecraft:1.21.x"
    mappings loom.officialMojangMappings()
    modImplementation "net.fabricmc:fabric-loader:0.15.+"
    modImplementation "net.fabricmc.fabric-api:fabric-api:0.98.+"
{{/if}}
}

java {
    withSourcesJar()
}

tasks.withType(JavaCompile).configureEach {
    it.options.release = 17
}

jar {
    from "LICENSE"
}

publishing {
    publications {
        mavenJava(MavenPublication) {
            from components.java
        }
    }

    repositories {
        // Add your Maven repository here
    }
}
